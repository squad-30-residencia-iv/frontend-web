# Copie este arquivo para .env e ajuste os valores.
# true  = as chamadas de /api são interceptadas pelo MSW (somente em desenvolvimento)
# false = as chamadas vão para o backend real
VITE_USE_MOCK=true

# Endereço do backend real (usado quando VITE_USE_MOCK=false). Vazio = mesma origem.
VITE_API_BASE_URL=
