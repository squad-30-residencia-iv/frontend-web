# Copie este arquivo para .env e ajuste os valores.
# true  = o login é interceptado pelo MSW (somente em desenvolvimento)
# false = o login vai para a API
VITE_USE_MOCK=false

# Endereço absoluto da API. Usado quando VITE_USE_MOCK=false.
# No computador: http://localhost:5026
# Na hospedagem: o HTTPS da API. O portal fica em outra origem.
VITE_API_BASE_URL=http://localhost:5026
